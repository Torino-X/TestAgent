    {"type": "row", "title": "Agent Runtime", "id": 3},
    {"type": "logs", "title": "任务、Worker、Graph 失败", "id": 4, "datasource": {"type": "loki", "uid": "TestAgent Loki"}, "targets": [{"expr": "{service=\"testagent-backend\"} | json | event=~\"agent\\..*\\.(failed|completed)\""}]},
    {"type": "row", "title": "Context Engine", "id": 5},
    {"type": "logs", "title": "Compose 与 Retrieval 诊断", "id": 6, "datasource": {"type": "loki", "uid": "TestAgent Loki"}, "targets": [{"expr": "{service=\"testagent-backend\"} | json | event=~\"context\\..*\""}]},
    {"type": "row", "title": "LLM 与依赖", "id": 7},
