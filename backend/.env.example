# ==================================================
# TestAgent 3.0 .env.example 配置（按功能分类整理版）
# 创建时间：2026-08-07
# 说明：与 .env 字段一一对应；所有敏感值（密码/Key/真实地址）必须替换
#       复制本文件为 .env 后再填写真实值
# ==================================================


# ==================================================
# 1. 应用基础配置
# ==================================================
# 同步 MySQL 连接（Alembic / 同步脚本使用）
DATABASE_SYNC_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/testagent?charset=utf8mb4
# 异步 MySQL 连接（FastAPI 异步引擎使用）
DATABASE_ASYNC_URL=mysql+aiomysql://USER:PASSWORD@HOST:3306/testagent?charset=utf8mb4
# 应用名称
APP_NAME=TestAgent
# 应用环境：development | production
APP_ENV=development
# ===== Structured backend logging =====
LOG_LEVEL=INFO
LOG_CONSOLE_ENABLED=1
LOG_FILE_ENABLED=1
LOG_DIR=./logs
LOG_FILE_MAX_BYTES=52428800
LOG_FILE_BACKUP_COUNT=10
LOG_REDACTION_ENABLED=1
LOG_LEVEL_HTTP=INFO
LOG_LEVEL_APPLICATION=INFO
LOG_LEVEL_AGENT=INFO
LOG_LEVEL_CONTEXT=INFO
LOG_LEVEL_INTEGRATION=INFO
LOG_LEVEL_SECURITY=INFO
LOG_SCHEMA_VERSION=2.0
LOG_SAMPLING_ENABLED=1
LOG_SUCCESS_SAMPLE_RATE=1.0
LOG_HEALTH_SAMPLE_RATE=0.01
LOG_RATE_LIMIT_ENABLED=1
LOG_RATE_LIMIT_WINDOW_SECONDS=60
LOG_MAX_EVENT_BYTES=32768
LOG_INCIDENT_BUNDLE_ENABLED=1

# Optional OpenTelemetry tracing.  Disabled by default: no collector/network
# exporter is required for normal backend operation.
OTEL_ENABLED=0
OTEL_SERVICE_NAME=testagent-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATE=1.0
# API 路由前缀
API_PREFIX=/api
# 本地存储根目录（uploads / artifacts / temp）
LOCAL_STORAGE_PATH=./data
# ── 阿里云 OSS 存储（durable object storage） ──
# 用户上传文件、对话中生成的产物（测试方案 / 文档）以及 Context Engine
# payload 全部落到 OSS bucket；DB 仅保留不透明 object key。
# LOCAL_STORAGE_PATH 仅用于短期处理 scratch 文件（Word 导出临时文件 /
# DocumentReader 抽取的图片等），不会作为业务文件本体保存。
#
# 必填四项（启动时 ``oss_is_configured`` 必须返回 True）：
#   OSS_ENDPOINT          阿里云 OSS Endpoint，例如
#                         https://oss-cn-hangzhou.aliyuncs.com
#   OSS_ACCESS_KEY_ID     RAM AccessKey ID（建议子账号并仅授权本 bucket）
#   OSS_ACCESS_KEY_SECRET RAM AccessKey Secret
#   OSS_BUCKET_NAME       目标 bucket 名（建议私有读写）
# 可选：
#   OSS_PREFIX            bucket 内对象 key 统一前缀；默认 testagent，
#                         多套环境共用 bucket 时改成各自前缀避免串扰。
OSS_ENDPOINT=https://oss-cn-your-region.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_PREFIX=testagent
# JWT 签名密钥（生产必须改；建议 openssl rand -base64 32）
SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION
# JWT 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 允许跨域来源列表（JSON 数组）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5318","http://127.0.0.1:5318"]


# ==================================================
# 2. LLM Model 配置（已弃用说明）
# ==================================================
# F015 — removed. Model configuration is now strictly per-user and
# stored in the ``model_configs`` table (encrypted API key).
# The legacy LLM_API_URL / LLM_MODEL_NAME / LLM_TIMEOUT /
# LLM_ENABLE_THINKING / DASHSCOPE_API_KEY environment variables are
# no longer read at runtime. Each user must configure their own
# model through the Settings page; the backend will surface a
# friendly "LLM_NOT_CONFIGURED" error otherwise.


# ==================================================
# 3. 外部依赖（Postgres / Redis / Worker 启动）
# ==================================================

# ── LangGraph Checkpoint 持久化（AWS Postgres / 自建 PG） ──
# LangGraph Checkpoint 持久化（AsyncPostgresSaver）
AGENT_RUNTIME_POSTGRES_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/langgraph?ssl=false
# 启动时自动建 checkpoint 表
AGENT_RUNTIME_POSTGRES_SETUP_ON_START=true

# ── Redis（跨 Worker InFlight 互斥 + 缓存） ──
# Redis 连接（InFlight 互斥 + 缓存）
AGENT_RUNTIME_REDIS_URL=redis://:PASSWORD@HOST:6379/0

# ── Worker 启动 ──
# AgentExecutionWorker 自动启动（关闭则只是单进程调试）
AGENT_RUNTIME_WORKER_AUTOSTART=true


# ==================================================
# 3.5. Business Cache Redis（Phase 1 缓存系统）
# ==================================================
# 独立于 Runtime Redis 的业务 Query Cache（详见设计文档 §4.2 / §30）。
# Runtime Redis 继续负责 LiveEventBus / InFlight；本段专门承接
# Auth / Config / Conversation / Task / Library / Context 缓存。
# Redis 拓扑：
#   - 开发：docker compose 起 redis-cache 容器，端口 6380
#   - 测试：redis-test-cache 容器，端口 6381
#   - 生产：独立 HA 实例，与 Runtime Redis 完全隔离
# ── 总开关 ──
# 关闭 → 所有 Domain Cache bypass；MySQL 继续工作；Runtime Redis 不受影响
CACHE_REDIS_ENABLED=true
# Business Cache Redis 连接串；留空 → Domain Cache 全部 bypass
CACHE_REDIS_URL=redis://:PASSWORD@HOST:6380/0
# 连接池上限（单 worker 共享一个 client；lifespan 创建，lifespan 关闭）
CACHE_REDIS_MAX_CONNECTIONS=100
# fail-fast 超时：Redis 不可达时不阻塞请求
CACHE_REDIS_CONNECT_TIMEOUT_MS=200
CACHE_REDIS_SOCKET_TIMEOUT_MS=100
CACHE_REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# ── Key / Schema ──
# Key 前缀；与 Runtime keyspace（inflight: / EventBus）完全隔离
CACHE_KEY_PREFIX=ta
# Schema 版本（payload envelope 含 v 字段；旧版本/损坏 payload 当 miss 处理）
CACHE_SCHEMA_VERSION=v1

# ── Cache fill lock（仅热点 spec） ──
# SET NX PX 的 TTL（ms）；只有 auth / model_config / knowledge / system_config /
# conversation_list 启用
CACHE_LOCK_TTL_MS=2000
CACHE_LOCK_WAIT_MS=200

# ── DB fallback 并发闸门 ──
# Cache loader 走 DB 时最多并发数（每 worker）；防止 Redis 故障时打穿 MySQL 连接池
CACHE_DB_FALLBACK_MAX_CONCURRENCY=5

# ── Circuit Breaker ──
# 连续错误阈值；开 breaker 后多久进入 half-open
CACHE_BREAKER_FAILURE_THRESHOLD=5
CACHE_BREAKER_OPEN_SECONDS=5

# ── Value size 保护 ──
# 超过此大小的 payload 跳过缓存（256 KiB；防 MEDIUMTEXT / 大 Tool output 污染 Redis）
CACHE_MAX_VALUE_BYTES=262144

# ── 后台维护 ──
# CacheMaintenanceWorker 周期（library purge 等低频清理任务）
CACHE_MAINTENANCE_INTERVAL_SECONDS=60

# ── Domain feature flags（独立粒度关闭） ──
# 任一关闭 → 该 domain 的 cache bypass，MySQL 继续工作
CACHE_AUTH_ENABLED=true
CACHE_CFG_ENABLED=true
CACHE_CONV_ENABLED=true
CACHE_TASK_ENABLED=true
CACHE_LIB_ENABLED=true
CACHE_CTX_ENABLED=true
CACHE_SEM_ENABLED=true
CACHE_FB_ENABLED=true


# ==================================================
# 4. LangGraph 引擎（双闸门 / Canary / 默认引擎）
# ==================================================

# LangGraph 总开关（关闭则任务走 Legacy Orchestrator）
AGENT_RUNTIME_LANGGRAPH_ENABLED=false
# 灰度比例 0-100（按 SHA1(task_public_id) 分桶）
AGENT_RUNTIME_CANARY_PERCENT=0
# 生产 LangGraph 路径 opt-in（双闸门之一）
AGENT_RUNTIME_PRODUCTION_DISPATCH_ENABLED=false
# 新任务默认引擎：langgraph | legacy
AGENT_RUNTIME_DEFAULT_ENGINE=legacy

# ── LLM 网关 ──
# 主模型 API 网关地址
AGENT_RUNTIME_LLM_BASE_URL=https://your-llm-gateway.example.com/v1


# ==================================================
# 5. 动态 Agent 主开关
# ==================================================
# 模板解析后进入 Preparation Agent
AGENT_RUNTIME_PREPARATION_AGENT_ENABLED=0
# 审查失败后进入 Repair Agent
AGENT_RUNTIME_REPAIR_AGENT_ENABLED=0
# 当前首次完整生成任务暂不启用增量 Agent
AGENT_RUNTIME_INCREMENTAL_AGENT_ENABLED=0
# 增量 Agent API 暂不启用
AGENT_RUNTIME_DYNAMIC_AGENT_API_ENABLED=0


# ==================================================
# 6. Phase 2.9B 动态叙事开关
# ==================================================
# 动态叙事总开关
AGENT_RUNTIME_PHASE29B_NARRATIVE_ENABLED=0
# Preparation Agent 叙事
AGENT_RUNTIME_PHASE29B_PREPARATION_NARRATIVE_ENABLED=0
# Repair Agent 叙事
AGENT_RUNTIME_PHASE29B_REPAIR_NARRATIVE_ENABLED=0
# 增量 Agent 未启用，对应叙事也关闭
AGENT_RUNTIME_PHASE29B_INCREMENTAL_NARRATIVE_ENABLED=0


# ==================================================
# 7. Phase 2.9B.4 LLM-first Narrative Composer
# ==================================================
# 每个 Tool 完成后生成模型叙事
AGENT_RUNTIME_PHASE29B_TOOL_NARRATIVE_ENABLED=0
# 同步叙事屏障：当前 Tool 的模型叙事完成或回退后，才进入下一个 Tool
AGENT_RUNTIME_PHASE29B_TOOL_NARRATIVE_BLOCKING_ENABLED=0
# 只在 Tool 最终事件/chunk_final 后生成一次叙事
AGENT_RUNTIME_PHASE29B_TOOL_NARRATIVE_FINAL_ONLY=0
# 任务完成前生成模型最终总结
AGENT_RUNTIME_PHASE29B_TASK_SUMMARY_NARRATIVE_ENABLED=0
# 模型超时、解析失败、校验失败时使用 2.9A 确定性叙事兜底
AGENT_RUNTIME_PHASE29B_DETERMINISTIC_FALLBACK_ENABLED=0
# 持久化流式叙事事件，支持刷新后恢复
AGENT_RUNTIME_PHASE29B_NARRATIVE_STREAM_PERSIST_ENABLED=0
# 单次叙事模型调用超时时间（秒）
AGENT_RUNTIME_PHASE29B_NARRATIVE_TIMEOUT_SECONDS=30
# 叙事输出不符合合同后，允许模型修复的次数
AGENT_RUNTIME_PHASE29B_NARRATIVE_REPAIR_ATTEMPTS=1
# 工具/Agent 公开叙事详细程度（开发者后端配置）：concise | standard | detailed
AGENT_RUNTIME_NARRATIVE_DETAIL_LEVEL=standard


# ==================================================
# 8. 3.0-context-engine 上下文管理
# ==================================================
# CE-03 / CE-04 / CE-05 完整能力配置
# 包括：Knowledge 检索、Memory 记忆、Embedder/Reranker Provider
# =================================================================
# ── CE-03 Knowledge 检索与索引后端 ──────────────────────────────
# Qdrant：向量数据库，存"按意思相近"的索引（dense 通道）
QDRANT_HOST=http://HOST
# Qdrant 端口
QDRANT_PORT=6333
# 是否 HTTPS（false=HTTP）
QDRANT_HTTPS=false
# Qdrant 鉴权 key
QDRANT_API_KEY=
# 可选：若需 gRPC（当前测试走 REST 6333，无需设置）
# QDRANT_PREFER_GRPC=false

# Elasticsearch：词法数据库，存"按关键词命中"的索引（lexical 通道）
# 非空即启用 Context 检索
ES_HOST=http://HOST
# ES 端口
ES_PORT=9200
# 是否 HTTPS
ES_HTTPS=false
# CA 证书路径（远程 HTTPS 设）
ES_CA_CERTS=
# ES 认证（方案 B：xpack.security.enabled=true）
ELASTIC_USER=elastic
# ES 密码（凭据不进日志）
ELASTIC_PASSWORD=

# ── Embedding / Reranker Provider（经 ModelConfig DB 配置，非 .env）───
# 双通道 dense 检索还需在 model_configs 配 embedding 能力（capability_type='embedding'
# + embedding_dimension），经 ProviderFactory 注入；.env 不承载这些。

# ── Embedding Provider（OpenAI 兼容，与主模型同格式；临时 .env 配置，不走 DB）──
# Embedding 模型服务端点（把文本转成坐标向量）
EMBEDDING_BASE_URL=https://your-embedding-endpoint.example.com/v1
# Embedding API 密钥
EMBEDDING_API_KEY=
# Embedding 模型名
EMBEDDING_MODEL=text-embedding-3-small
# Embedding 输出维度（不匹配 → 跳过 dense 通道）
EMBEDDING_DIMENSION=1536
# 是否归一化向量（cosine 相似度时一般 true）
EMBEDDING_NORMALIZE=true
# Embedding 单次调用超时（秒）
EMBEDDING_TIMEOUT=30
# Rerank 模型服务端点（对召回结果重排序）
RERANKER_BASE_URL=https://your-rerank-endpoint.example.com/v1
# Rerank API 密钥
RERANKER_API_KEY=
# Rerank 模型名
RERANKER_MODEL=text-rerank-001

# ── Context Engine 总开关（master switch，缺则全旁路） ──
# 【开启后】启用 Context Engine：所有 LLM 调用经 ContextEngine.compose() 装配上下文；关闭则全旁路走 Legacy Orchestrator，所有 CE 用例会"看起来 PASS"但实际未走 Context Engine
CONTEXT_ENGINE_ENABLED=1
# Release guard：开启后启动期校验所有 task-semantic key 齐全 + 所有 MIG_*=true，否则 ContextEngineReleaseConfigurationError；建议生产全量部署时再=1
CONTEXT_ENGINE_FULL_CHAIN_REQUIRED=0
# 【开启后】动态 Agent（Preparation/Repair/Incremental）也接入 ContextEngine；master 闸门——任一 MIG_*=true 必须同时开它，否则 fail-closed
CONTEXT_ENGINE_AGENT_ENABLED=1
# 是否对 Tool 输出做上下文治理（截断/脱敏/审计，按 PayloadMode 三态生效）；当前测试不必开
CONTEXT_TOOL_OUTPUT_GOVERNANCE_ENABLED=0
# 【开启后】启动文档索引后台 Worker，上传文件自动进入 Knowledge 通道；不开则文件不进 RAG，CE-RAG-01 步骤 B/C 无法验证
CONTEXT_INDEX_WORKER_ENABLED=1

# ── Memory 长期记忆（用户/项目偏好的长期记忆） ──
# 【开启后】把 status='active' 的 context_memories 读进 Prompt；MemorySourceAdapter 实际工作的前提，CE-MEM-01/02/03 全部依赖此项
CONTEXT_MEMORY_READ_ENABLED=1
# 【开启后】允许 memory.extract.* profile 把新候选写进 context_memories；不开则 Memory 用例没有写入侧，新记忆无法产生
CONTEXT_MEMORY_WRITE_ENABLED=1
# 是否自动从对话抽取记忆候选（被动式）；当前测试可保持 0，由测试员手动发"请记住：..."触发写入
CONTEXT_MEMORY_AUTO_EXTRACT_ENABLED=1
# 是否自动把候选升级为 active（建议关，避免污染 user scope；守禁令 22）
CONTEXT_MEMORY_AUTO_ACTIVATE_ENABLED=1

# ── RAG 检索总开关（外置 Qdrant/ES/Embedding 见上） ──
# 【开启后】Knowledge 通道（ES lexical + Qdrant dense + RRF/Rerank 融合）参与 Context Assembly；CE-RAG-01 步骤 B 多文档召回的前置
CONTEXT_RETRIEVAL_ENABLED=1
# 【开启后】启用 Elasticsearch 关键词检索通道；需 CONTEXT_RETRIEVAL_ENABLED=1 且 ES_HOST/ELASTIC_PASSWORD 已配
CONTEXT_LEXICAL_RETRIEVAL_ENABLED=1
# 【开启后】启用 Qdrant 向量检索通道；需 QDRANT_HOST/PORT + EMBEDDING_BASE_URL/API_KEY/DIMENSION 全部就绪
CONTEXT_DENSE_RETRIEVAL_ENABLED=1
# 【开启后】lexical + dense 双通道走 Weighted RRF（k=60）融合；需上述两个通道都开
CONTEXT_HYBRID_FUSION_ENABLED=1
# 是否启用 Rerank（无 Reranker 服务时设 0，自动回退 RRF）；当前测试可保持 0
CONTEXT_RERANK_ENABLED=0

# ── Compression 长上下文压缩（上下文超长时压缩成摘要） ──
# 【开启后】启用 Conversation Compaction 总开关；UI 显示"压缩上下文"按钮，POST .../compact 生效，CE-COMP-01/02 全部用例的前置
CONTEXT_COMPACTION_ENABLED=1
# 【开启后】启用 Conversation Compactor；压缩把多轮对话→Conversation Summary（supersede 链，Payload First 三段事务）；不开则手动压缩报 503
CONTEXT_CONVERSATION_COMPACTION_ENABLED=1
# AgentLoop 子图压缩；CE-COMP-02 涉及；当前测试可保持 0
CONTEXT_AGENT_LOOP_COMPACTION_ENABLED=0
# FullReplace 仅 PROVIDER_CONTEXT_ERROR 触发，抢救式压缩；严禁手动开（守禁令 25）
CONTEXT_FULL_REPLACE_ENABLED=0

# ── 业务子图迁移（CE-04 核心；8 项决定业务走 LangGraph 还是 Legacy） ──
# 评审子图：test_plan.review call-site 走 ContextInvokerBridge（默认走 legacy）
MIG_REVIEW=0
# 修复子图：test_plan.repair.{plan,regenerate,review} call-site 走 ContextInvokerBridge
MIG_REPAIR=0
# 生成子图：test_plan.generate.{outline,batch} call-site 走 ContextInvokerBridge
MIG_GENERATE=0
# 准备子图：test_plan.preparation.decide / test_plan.section_suggest call-site 走 ContextInvokerBridge
MIG_PREPARATION=0
# 增量子图：test_plan.incremental.{diff,regenerate} call-site 走 ContextInvokerBridge
MIG_INCREMENTAL=0
# 【开启后】聊天子图：chat.reply call-site 走 ContextInvokerBridge；普通对话复用 chat.reply.v1 profile；CE-MEM-02/03 验证 mode=off/on 行为依赖此项
MIG_CHAT=1
# 摘要子图：conversation.title / completion.summary call-site 走 ContextInvokerBridge
MIG_SUMMARY=0
# 叙事子图：test_plan.tool_narrative / task_summary_narrative / dynamic_agent.planner call-site 走 ContextInvokerBridge
MIG_NARRATIVE=0

# ── LangGraph 子图开关（与第 4 组 LangGraph 引擎配合） ──
# Interrupt 节点（用户暂停/确认点）
AGENT_RUNTIME_INTERRUPT_LANGGRAPH_ENABLED=0
# Preparation 子图
AGENT_RUNTIME_PREPARATION_LANGGRAPH_ENABLED=0
# Repair 子图
AGENT_RUNTIME_REPAIR_LANGGRAPH_ENABLED=0
# Incremental 子图
AGENT_RUNTIME_INCREMENTAL_LANGGRAPH_ENABLED=0

# ── 上下文安全 ──
# PII 处理：redact=替换 | mask=打码 | block=拒绝并报错
CONTEXT_PII_MODE=redact
# Debug API 是否启用（admin 路由）
CONTEXT_DEBUG_API_ENABLED=0
# Context Usage 卡片的诊断收据（快照 ID、调用点、来源）；开发/联调可设 1，生产必须为 0。
CONTEXT_USAGE_DEBUG_DETAILS_ENABLED=0
# Debug 四重门控解锁密钥（非生产）
CONTEXT_DEBUG_UNLOCK_SECRET=
# 严禁开启：禁止完整 Prompt 持久化/返回
CONTEXT_FULL_PROMPT_DEBUG_ENABLED=0

# ── 开发态 Prompt Dump（仅本地调试；与上面的 FULL_PROMPT_DEBUG 无关）──
# 区别：本开关只把 Prompt 落成本地 Markdown 文件，不写 DB、不经 API 返回。
# 生产必须保持 0。开启后每次 ContextEngine.compose() 生成一个 .md
# （含用途说明 + 预算表 + 完整 Prompt 原文）。请定期清理该目录。
CONTEXT_PROMPT_DUMP_ENABLED=0
# Dump 输出目录（相对 backend/ 工作目录）；目录已在 .gitignore 中
CONTEXT_PROMPT_DUMP_DIR=./tmp/prompt_dumps

# ── opaque cursor 加密密钥 ──
# AES-256-GCM cursor 密钥（≥32 字节）；缺失 → cursor 端点 503
# 生成方式：openssl rand -base64 32
CONTEXT_CURSOR_SECRET=

# ── Retention 数据清理 ──
# 1=只统计不删（默认生产）；0=真删（生产需人工授权）
CONTEXT_RETENTION_DRY_RUN=1
# 是否启动 Retention Worker
CONTEXT_RETENTION_WORKER_ENABLED=0

# ── LangGraph Checkpoint 持久化（跨 Worker 必备） ──
# Checkpoint 存储：memory=开发友好 | postgres=生产必备
AGENT_RUNTIME_CHECKPOINTER_BACKEND=memory
# Postgres 连接池大小
AGENT_RUNTIME_POSTGRES_POOL_SIZE=5
# 跨 Worker InFlight 互斥：防止两个 Worker 同时接管同一任务
AGENT_RUNTIME_REDIS_INFLIGHT_URL=redis://:PASSWORD@HOST:6379/1
# Redis 锁 TTL（秒）：Worker 崩溃后 TTL 兜底释放
AGENT_RUNTIME_REDIS_INFLIGHT_TTL_SECONDS=1800
# Redis keyspace 前缀，与其它业务隔离
AGENT_RUNTIME_REDIS_INFLIGHT_LOCK_PREFIX=inflight:
# admin CLI token（update_engine_type_admin 命令使用）
AGENT_RUNTIME_ADMIN_TOKEN=

# ── 开发态故障注入（可删除模块 backend/dev_fault_injection）──
# 业务代码只调用 app.fault_injection_gateway；真实故障构造集中在
# backend/dev_fault_injection，发布前可整目录删除，gateway 会自动 no-op。
# APP_ENV=production/prod 时强制禁用，即使下面开关误开也不生效。
FAULT_INJECTION_ENABLED=0
# 允许生效的环境，默认 development,dev,local,test。
FAULT_INJECTION_ALLOWED_ENV=development,dev,local,test
# 可选：只对指定 task_id 生效，留空表示不限制。
FAULT_INJECTION_TASK_IDS=
# 同一注入点只触发第一个匹配场景，多个场景用逗号分隔。
# 常用 JSON 审查异常：
# result_review.schema_header_mismatch
# result_review.missing_section
# result_review.json_truncate
# result_review.empty_section_content
# result_review.section_invalid_value
# result_review.extra_table_without_placeholder
# result_review.multiple_tables_for_single_placeholder
# result_review.missing_table_for_placeholder
# result_review.table_row_not_object
# Word 格式损失中断异常：
# format_loss.bookmark_simulate
FAULT_INJECTION_SCENARIOS=

# 兼容旧开关：如果未设置 FAULT_INJECTION_SCENARIOS，会读取以下 legacy 开关。
FAULT_ENABLED=0
FAULT_SCHEMA_HEADER_MISMATCH=0
FAULT_MISSING_SECTION=0
FAULT_JSON_TRUNCATE=0
FAULT_EMPTY_SECTION_CONTENT=0
FAULT_SECTION_INVALID_VALUE=0
FAULT_FORMAT_LOSS_BOOKMARK_SIMULATE=0

# ── 文档预览 ──
# 使用真实 Office 排版引擎将原始 DOCX 转为 PDF，完整保留页面、样式、表格、图片和页眉页脚。
# Windows 示例：C:\Program Files\LibreOffice\program\soffice.com
# Linux 示例：/usr/bin/libreoffice
# Windows 上检测到 Microsoft Word 时，会自动优先使用其原生 PDF 导出；
# 如需固定使用 LibreOffice，再填写此路径。
DOCUMENT_PREVIEW_OFFICE_BIN=
# 单次转换最长等待秒数；超时后会清理临时目录，原始文件仍只保存在 OSS。
DOCUMENT_PREVIEW_OFFICE_TIMEOUT_SECONDS=90
